---
import { Icon } from "astro-icon/components";
import GradientBar from "../components/GradientBar.astro";
import { quotes } from "./quotes";
---

<footer class="footer-container">
	<p id="footer-quote" class="footer-quote" aria-live="polite"></p>
	<div class="gradient-bar-container">
		<GradientBar />
	</div>
	<div class="social-links">
		<a rel="me" href="https://github.com/errorcodezero" aria-label="Github">
			<Icon class="icon" name="mdi:github" />
		</a>
		<a rel="me" href="/rss.xml" aria-label="RSS Feed">
			<Icon class="icon" name="mdi:rss" />
		</a>
		<a rel="me" href="mailto:me@errorcodezero.dev" aria-label="Email Me">
			<Icon class="icon" name="mdi:email" />
		</a>
		<a
			rel="me"
			href="https://twitter.com/errorcodezero_"
			aria-label="Twitter"
		>
			<Icon class="icon" name="mdi:twitter" />
		</a>
		<a
			rel="me"
			href="https://steamcommunity.com/id/yeetsquad747"
			aria-label="Steam Community Profile"
		>
			<Icon class="icon" name="mdi:steam" />
		</a>
		<a rel="me" href="https://mas.to/@errorcodezero" aria-label="Mastodon">
			<Icon class="icon" name="mdi:mastodon" />
		</a>
	</div>
</footer>

<style>
	#ad {
		margin-top: 1em;
		margin-bottom: 1em;
	}

	.gradient-bar-container {
		display: flex;
		justify-content: center;
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.5em;
		text-align: center;
	}

	.icon {
		width: 2.5em;
		height: 2.5em;
		display: block;
	}

	.social-links a:hover {
		opacity: 0.7;
		transition: opacity 0.2s ease;
	}

	.footer-quote {
		font-size: 0.85rem;
		color: var(--muted);
		font-style: italic;
		margin: 0;
		min-height: 1.2em;
		cursor: pointer;
		user-select: none;
	}
</style>

<script is:inline define:vars={{ quotes }}>
	let currentIndex = Math.floor(Math.random() * quotes.length);

	function setQuote() {
		const el = document.getElementById("footer-quote");
		if (el) el.textContent = quotes[currentIndex];
	}

	function nextQuote() {
		currentIndex = (currentIndex + 1) % quotes.length;
		setQuote();
	}

	function init() {
		currentIndex = Math.floor(Math.random() * quotes.length);
		setQuote();
		const el = document.getElementById("footer-quote");
		el?.addEventListener("click", nextQuote);
	}

	init();
	document.addEventListener("astro:after-swap", init);
</script>
