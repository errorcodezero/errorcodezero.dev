---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "~/styles/global.css";
import coolerLogo from "~/assets/cooler_logo.svg";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description: string;
	image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = coolerLogo.src } = Astro.props;
import { SITE_TITLE } from "../consts";
import logo from "../assets/logo.png";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href={logo.src} />

<!-- Font preloads -->
<link
	rel="preload"
	href="/fonts/geist/geist-latin-variable.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/fran-sans/fransans-solid.woff"
	as="font"
	type="font/woff"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/fran-sans/fransans-panel.woff"
	as="font"
	type="font/woff"
	crossorigin
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{`${title} | ${SITE_TITLE}`}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={`${title} | ${SITE_TITLE}`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.url)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={`${title} | ${SITE_TITLE}`} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.url)} />

<!--My mastodon account(This is here for verifying the account) -->
<link rel="me" href="https://mas.to/@errorcodezero" />

<!--Mastodon Plays Snake(This is here for verifying the account) -->
<link rel="me" href="https://botsin.space/@snake" />
<link rel="me" href="https://mastodon.world/@snake" />
<meta name="fediverse:creator" content="@errorcodezero@mas.to" />
<meta name="fediverse:creator" content="@snake@mastodon.world" />

<!-- Client Router -->
<ClientRouter />

<!-- Transit map background -->
<script is:inline>
	(function () {
		var COLORS = [
			[137, 180, 250],
			[203, 166, 247],
			[243, 139, 168],
			[166, 227, 161],
			[249, 226, 175],
			[250, 179, 135],
			[148, 226, 213],
		];

		var drawFn = null;
		window.addEventListener("resize", function () {
			if (drawFn) drawFn();
		});

		function inject() {
			document.getElementById("transit-bg")?.remove();
			var canvas = document.createElement("canvas");
			canvas.id = "transit-bg";
			canvas.style.cssText =
				"position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:-1;pointer-events:none;";
			document.body.prepend(canvas);
			var ctx = canvas.getContext("2d");

			drawFn = function () {
				function rng() {
					return Math.random();
				}

				canvas.width = window.innerWidth;
				canvas.height = window.innerHeight;
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				var W = canvas.width,
					H = canvas.height;

				for (var l = 0; l < 100; l++) {
					var c = COLORS[l % COLORS.length];
					var alpha = 0.13;

					var edge = Math.floor(rng() * 4);
					var x, y, dx, dy;
					if (edge === 0) {
						x = rng() * W;
						y = 0;
						dx = 0;
						dy = 1;
					} else if (edge === 1) {
						x = W;
						y = rng() * H;
						dx = -1;
						dy = 0;
					} else if (edge === 2) {
						x = rng() * W;
						y = H;
						dx = 0;
						dy = -1;
					} else {
						x = 0;
						y = rng() * H;
						dx = 1;
						dy = 0;
					}

					var pts = [{ x: x, y: y }];
					var turns = Math.floor(rng() * 3) + 2;
					for (var t = 0; t < turns; t++) {
						var dist = (rng() * 0.4 + 0.2) * Math.max(W, H);
						x += dx * dist;
						y += dy * dist;
						pts.push({ x: Math.round(x), y: Math.round(y) });
						var sign = rng() > 0.5 ? 1 : -1;
						var ndx = dy * sign,
							ndy = -dx * sign;
						dx = ndx;
						dy = ndy;
					}
					pts.push({
						x: x + dx * Math.max(W, H),
						y: y + dy * Math.max(W, H),
					});

					ctx.strokeStyle =
						"rgba(" +
						c[0] +
						"," +
						c[1] +
						"," +
						c[2] +
						"," +
						alpha +
						")";
					ctx.lineWidth = 2;
					ctx.lineJoin = "round";
					ctx.lineCap = "round";
					ctx.beginPath();
					ctx.moveTo(pts[0].x, pts[0].y);
					for (var i = 1; i < pts.length; i++)
						ctx.lineTo(pts[i].x, pts[i].y);
					ctx.stroke();

					for (var i = 1; i < pts.length - 1; i++) {
						var p = pts[i];
						ctx.strokeStyle =
							"rgba(" +
							c[0] +
							"," +
							c[1] +
							"," +
							c[2] +
							"," +
							alpha * 2.2 +
							")";
						ctx.lineWidth = 1.5;
						ctx.beginPath();
						ctx.arc(p.x, p.y, 5, 0, Math.PI * 2);
						ctx.stroke();
						ctx.fillStyle = "rgba(17,17,27,0.9)";
						ctx.beginPath();
						ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
						ctx.fill();
					}
				}
			};

			drawFn();
		}

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", inject);
		} else {
			inject();
		}
		document.addEventListener("astro:after-swap", inject);
	})();
</script>

<!-- Simple Analytics -->
<script
	is:inline
	type="text/partytown"
	data-collect-dnt="true"
	async
	src="https://sa.errorcodezero.dev/latest.js"></script>
